{
  "name": "Archie",
  "short_name": "Archie",
  "description": "Archie on your phone: your day, class recordings, notes, news and chat, synced with your PC.",
  "id": "/",
  "start_url": "/#today",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "icons": [
    {"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Record class", "url": "/#class", "icons": [{"src": "/icon-192.png", "sizes": "192x192"}]},
    {"name": "Add", "url": "/#add", "icons": [{"src": "/icon-192.png", "sizes": "192x192"}]},
    {"name": "Ask Archie", "url": "/#chat", "icons": [{"src": "/icon-192.png", "sizes": "192x192"}]}
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"title": "title", "text": "text", "url": "url", "files": [{"name": "files", "accept": ["*/*"]}]}
  }
}
